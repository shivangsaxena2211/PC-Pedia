{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PC Pedia GPU Catalog Record",
  "description": "Single GPU hardware record for verified catalog import. Phase 1 schema only — no product files yet.",
  "type": "object",
  "required": ["category", "manufacturer", "family", "product", "source", "specifications"],
  "properties": {
    "category": {
      "type": "string",
      "const": "GPU"
    },
    "manufacturer": {
      "type": "string",
      "enum": ["NVIDIA", "AMD", "Intel"]
    },
    "family": {
      "type": "string",
      "description": "Product family: GeForce, Radeon RX, Arc, etc."
    },
    "series": {
      "type": "string"
    },
    "generation": {
      "type": "string",
      "description": "Marketing generation or architecture series label"
    },
    "architecture": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "date": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string" },
        "slug": {
          "type": "string",
          "pattern": "^(nvidia|amd|intel)-[a-z0-9-]+$",
          "description": "Canonical slug: {manufacturer}-{family}-{model}"
        },
        "description": { "type": "string" },
        "release_date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["active", "discontinued", "upcoming"] },
        "is_popular": { "type": "boolean" },
        "architecture": { "type": "string" }
      },
      "additionalProperties": true
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "alt_text": { "type": "string" },
          "is_primary": { "type": "boolean" },
          "image_type": { "type": "string" }
        }
      }
    },
    "specifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "group": { "type": "string" },
          "key": {
            "type": "string",
            "description": "Canonical snake_case key from gpu_spec_definitions.py"
          },
          "value": { "type": "string" },
          "unit": { "type": "string" }
        }
      },
      "description": "Must include market_segment (desktop, mobile, workstation, datacenter, or server)"
    },
    "benchmarks": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": false
}
